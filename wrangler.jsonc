{
  "name": "mindharbor-site",
  "compatibility_date": "2026-10-06",
  // Static product page (site/) plus the anonymous feedback endpoint (src/worker.js).
  "main": "src/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    // Create with: wrangler d1 create mindharbor-feedback, then apply schema.sql.
    { "binding": "FEEDBACK", "database_name": "mindharbor-feedback", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "routes": [
    { "pattern": "mindharbor.fezone.tw", "custom_domain": true }
  ]
}
