{
  "name": "mindharbor-site",
  "compatibility_date": "2026-10-06",
  // Static product page (site/) plus the anonymous feedback endpoint (src/worker.js).
  "main": "src/worker.js",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/.well-known/openai-apps-challenge"]
  },
  "vars": {
    // Token shown by the OpenAI plugin portal's domain-verification step. Empty serves 404.
    "OPENAI_APPS_CHALLENGE": ""
  },
  "d1_databases": [
    // Schema: schema.sql.
    { "binding": "FEEDBACK", "database_name": "mindharbor-feedback", "database_id": "4daf01d4-db8a-4833-bbe7-28ac41c8c9c4" }
  ],
  "routes": [
    { "pattern": "mindharbor.fezone.tw", "custom_domain": true }
  ]
}
